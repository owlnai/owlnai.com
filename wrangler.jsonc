// Cloudflare Workers config. `pnpm build` writes the Worker and the static files to .output/, and
// ViteHub generates .output/server/wrangler.json from this file plus the bindings its features need.
// Workers Builds deploys it with `pnpm exec nitro deploy --prebuilt`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "owlnai-com",
  // ViteHub's tested date. From 2025-09-01 Workers provide node:fs, which Nuxt Content's server code imports.
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  // Every deploy replaces the Worker's plain variables with these, so variables added in the dashboard
  // disappear on the next push. The Last.fm API key is a secret instead, which deploys leave alone:
  // `npx wrangler secret put NUXT_LASTFM_API_KEY --name owlnai-com`
  "vars": {
    "NUXT_LASTFM_USER": "owlnai"
  },
  "observability": { "enabled": true },
  // Pages reach the Worker before the static files so `?card=small` can swap in the small share card
  // (server/middleware/share-card.ts); the Worker hands every other page straight back. Build files and photos
  // skip the Worker.
  "assets": {
    "run_worker_first": ["/*", "!/_nuxt/*", "!/_og/*", "!/_og-static-fonts/*", "!/_ipx/*", "!/places/*/*", "!/uses/*"]
  },
  // Workers Builds runs `npx wrangler preview` on other branches, which refuses to run without this block.
  // Previews get their own cache namespace (created 2026-11-21) so they never write to the live site's cache,
  // and their own secrets, shared by every preview through the base config:
  // `npx wrangler preview base-config secret put NUXT_LASTFM_API_KEY`. Without that key the music widget
  // shows nothing in previews.
  "previews": {
    "vars": {
      "NUXT_LASTFM_USER": "owlnai"
    },
    "kv_namespaces": [{ "binding": "CACHE", "id": "5b7016a2f5be491d8390a01f2e1e43bd" }]
  }
}
